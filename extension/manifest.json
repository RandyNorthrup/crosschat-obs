{
  "manifest_version": 3,
  "name": "CrossChat",
  "version": "1.6.0",
  "description": "Companion to the CrossChat hub for OBS: starts and ends your X livestream with OBS, brings in chat from your own TikTok LIVE page, Facebook Live Producer and Instagram live, and posts chat replies to YouTube, X, TikTok, Facebook, Instagram and Rumble. Talks only to the hub on this PC and reads no logins.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [],
  "host_permissions": [
    "http://127.0.0.1:4466/*",
    "https://studio.x.com/*",
    "https://www.youtube.com/live_chat*",
    "https://www.tiktok.com/*",
    "https://www.facebook.com/live/producer*",
    "https://www.instagram.com/",
    "https://rumble.com/chat/popup/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://studio.x.com/live*"
      ],
      "js": [
        "content.js",
        "x-chat.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://127.0.0.1:4466/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/live_chat*"
      ],
      "js": [
        "youtube.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.tiktok.com/*"
      ],
      "js": [
        "tiktok.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.facebook.com/live/producer*"
      ],
      "js": [
        "facebook.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.instagram.com/"
      ],
      "js": [
        "instagram.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://rumble.com/chat/popup/*"
      ],
      "js": [
        "rumble.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://rumble.com/chat/popup/*"
      ],
      "js": [
        "rumble-confirm.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ]
}
