{
  "manifest_version": 3,
  "name": "CrossChat",
  "version": "1.3.0",
  "description": "Companion to the CrossChat hub for OBS: starts and ends your X livestream with OBS, and posts chat replies to Twitch, YouTube and X. Talks only to the hub on this PC.",
  "minimum_chrome_version": "116",
  "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"},
  "permissions": ["cookies"],
  "host_permissions": [
    "http://127.0.0.1:4466/*",
    "https://studio.x.com/*",
    "https://www.twitch.tv/*",
    "https://www.youtube.com/live_chat*"
  ],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {"matches": ["https://studio.x.com/live*"], "js": ["content.js", "x-chat.js"], "run_at": "document_idle"},
    {"matches": ["http://127.0.0.1:4466/*"], "js": ["bridge.js"], "run_at": "document_start"},
    {"matches": ["https://www.youtube.com/live_chat*"], "js": ["youtube.js"], "all_frames": true, "run_at": "document_idle"}
  ]
}
